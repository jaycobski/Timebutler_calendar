{
  "name": "@timebutler/calendar-frontend",
  "version": "1.0.0",
  "description": "TimeButler Calendar MVP - German holiday bridge weekend optimizer frontend",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "export": "next export",
    "lint": "next lint --dir src --dir pages --dir components",
    "lint:fix": "next lint --fix --dir src --dir pages --dir components",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"pages/**/*.{ts,tsx,js,jsx}\" \"components/**/*.{ts,tsx,js,jsx}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,json,css,md}\" \"pages/**/*.{ts,tsx,js,jsx}\" \"components/**/*.{ts,tsx,js,jsx}\"",
    "test": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:integration": "jest --testPathPattern=integration",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:a11y": "jest --testPathPattern=accessibility",
    "test:mobile": "playwright test tests/mobile/",
    "test:mobile:responsive": "playwright test tests/mobile/responsive.test.ts",
    "test:mobile:german-ux": "playwright test tests/mobile/german-ux-validation.test.ts",
    "test:mobile:viewport": "playwright test tests/mobile/viewport-matrix.test.ts",
    "test:mobile:interactions": "playwright test tests/mobile/interaction-patterns.test.ts",
    "test:mobile:performance": "playwright test tests/mobile/ --grep=\"performance\"",
    "lighthouse": "lhci autorun",
    "lighthouse:local": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-report.json",
    "lighthouse:constitutional": "lighthouse http://localhost:3000 --output=json --output-path=./lighthouse-constitutional.json --throttling-method=simulate --throttling.cpuSlowdownMultiplier=4 --throttling.rttMs=150 --throttling.throughputKbps=1638.4 --form-factor=mobile",
    "bundle-analyzer": "cross-env ANALYZE=true npm run build",
    "bundle-size": "npm run build && bundlesize",
    "bundle-optimize": "cross-env NODE_ENV=production webpack --config webpack.config.js",
    "bundle-monitor": "npm run build && node scripts/bundle-monitor.js",
    "performance:check": "npm run build && node scripts/performance-budget-checker.js",
    "performance:monitor": "npm run lighthouse:constitutional && npm run performance:check",
    "screen-reader": "jest --testPathPattern=screen-reader",
    "i18n:extract": "next-translate-extract",
    "prepare": "husky install"
  },
  "dependencies": {
    "next": "^14.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "typescript": "^5.3.3",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@types/node": "^20.11.5",
    "next-translate": "^2.6.2",
    "next-translate-plugin": "^2.6.2",
    "clsx": "^2.1.0",
    "date-fns": "^2.30.0",
    "date-fns-tz": "^2.0.1",
    "focus-trap-react": "^10.2.3",
    "react-aria": "^3.31.0",
    "react-hook-form": "^7.49.2",
    "react-hot-toast": "^2.4.1",
    "@headlessui/react": "^1.7.17",
    "@heroicons/react": "^2.0.18",
    "js-cookie": "^3.0.5",
    "@types/js-cookie": "^3.0.6",
    "tailwindcss": "^3.4.1",
    "@tailwindcss/forms": "^0.5.7",
    "@tailwindcss/typography": "^0.5.10",
    "autoprefixer": "^10.4.17",
    "postcss": "^8.4.33"
  },
  "devDependencies": {
    "@next/bundle-analyzer": "^14.1.0",
    "@types/jest": "^29.5.11",
    "@types/testing-library__jest-dom": "^6.0.0",
    "@testing-library/react": "^14.1.2",
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/user-event": "^14.5.2",
    "@playwright/test": "^1.41.1",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "jest-axe": "^8.0.0",
    "@axe-core/playwright": "^4.8.4",
    "@axe-core/react": "^4.8.4",
    "axe-core": "^4.8.4",
    "eslint": "^8.56.0",
    "eslint-config-next": "^14.1.0",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-testing-library": "^6.2.0",
    "eslint-plugin-jest-dom": "^5.1.0",
    "prettier": "^3.2.4",
    "prettier-plugin-tailwindcss": "^0.5.11",
    "@lhci/cli": "^0.12.0",
    "cross-env": "^7.0.3",
    "husky": "^8.0.3",
    "lint-staged": "^15.2.0",
    "webpack-bundle-analyzer": "^4.10.1",
    "compression-webpack-plugin": "^10.0.0",
    "terser-webpack-plugin": "^5.3.10",
    "bundlesize": "^0.18.2",
  },
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "browserslist": [
    "defaults",
    "not ie 11",
    "not op_mini all"
  ],
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timebutler/calendar-mvp.git"
  },
  "keywords": [
    "timebutler",
    "calendar",
    "holidays",
    "vacation",
    "bridge-weekends",
    "germany",
    "accessibility",
    "wcag",
    "react",
    "nextjs",
    "typescript"
  ],
  "author": "TimeButler Team",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/timebutler/calendar-mvp/issues"
  },
  "homepage": "https://github.com/timebutler/calendar-mvp#readme"
}