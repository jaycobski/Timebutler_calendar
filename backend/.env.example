# Node Environment
NODE_ENV=development
PORT=3001

# Database Configuration
DATABASE_URL=postgresql://user:password@localhost:5432/timebutler_calendar_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=timebutler_calendar_dev
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Redis Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Email Service (Resend)
RESEND_API_KEY=re_your_api_key_here
FROM_EMAIL=noreply@timebutler.com
FROM_NAME=TimeButler Calendar

# German Holiday API
GERMAN_HOLIDAY_API_KEY=your_government_api_key_here
GERMAN_HOLIDAY_API_URL=https://feiertage-api.de/api

# Security & Performance
JWT_SECRET=your_very_secure_jwt_secret_minimum_32_chars
RATE_LIMIT_MAX=1000
RATE_LIMIT_WINDOW_MS=900000
CORS_ORIGIN=http://localhost:3000,https://calendar.timebutler.com

# Monitoring & Logging
LOG_LEVEL=info
METRICS_ENABLED=true
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Cache Configuration
CACHE_TTL_HOLIDAYS=2592000
CACHE_TTL_BRIDGES=86400
CACHE_TTL_EXPORTS=1800

# Performance Settings
MAX_PAYLOAD_SIZE=1048576
CONNECTION_TIMEOUT=30000
KEEP_ALIVE_TIMEOUT=5000
BODY_LIMIT=1048576

# Email Template Configuration
EMAIL_TEMPLATE_CACHE_TTL=3600
CALENDAR_EXPORT_TTL=2592000

# GDPR Compliance
DATA_RETENTION_DAYS=90
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Development Only
BUNDLE_ANALYZE=false
DEBUG_MODE=false
MOCK_EMAIL_SERVICE=false
DISABLE_RATE_LIMITING=false