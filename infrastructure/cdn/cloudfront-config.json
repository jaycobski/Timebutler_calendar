    "viewerProtocolPolicy": "redirect-to-https",
    "compress": true,
    "cachePolicyId": "GERMAN_OPTIMIZED_CACHE_POLICY",
    "originRequestPolicyId": "GERMAN_ORIGIN_REQUEST_POLICY",
