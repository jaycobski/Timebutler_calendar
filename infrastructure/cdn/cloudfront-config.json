      "viewerProtocolPolicy": "https-only",
      "compress": true,
      "cachePolicyId": "HOLIDAY_DATA_CACHE_POLICY",
      "originRequestPolicyId": "GERMAN_ORIGIN_REQUEST_POLICY",
      "responseHeadersPolicyId": "API_SECURITY_HEADERS_POLICY",
      "allowedMethods": ["GET", "HEAD", "OPTIONS"],
      "ttl": {
        "defaultTTL": 86400,
        "maxTTL": 604800,
        "minTTL": 3600
      },
      "comment": "German holiday data - cache for 24h with 7d max"
    },
    {
      "pathPattern": "/api/v1/bridge-weekends/*",
