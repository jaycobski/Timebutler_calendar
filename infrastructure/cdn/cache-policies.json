{
  "comment": "CDN Cache Policies for TimeButler Calendar - German Market Optimization",
  "version": "2.0",
  "lastUpdated": "2025-01-24",
  "policies": {
    "GERMAN_OPTIMIZED_CACHE_POLICY": {
      "name": "TimeButler-German-Optimized-Cache",
      "comment": "Optimized caching for German users with GDPR compliance",
      "defaultTTL": 3600,
      "maxTTL": 86400,
      "minTTL": 300,
      "parametersInCacheKeyAndForwardedToOrigin": {
        "enableAcceptEncodingBrotli": true,
        "enableAcceptEncodingGzip": true,
        "queryStringsConfig": {
          "queryStringBehavior": "whitelist",
          "queryStrings": [
            "state",
            "lang",
            "year",
            "month",
            "timezone",
            "version"
          ]
        },
        "headersConfig": {
          "headerBehavior": "whitelist",
          "headers": [
            "Accept-Language",
            "CloudFront-Viewer-Country",
            "CloudFront-Viewer-Country-Region",
            "CloudFront-Is-Mobile-Viewer",
            "CloudFront-Viewer-Time-Zone"
          ]
        },
        "cookiesConfig": {
          "cookieBehavior": "whitelist",
          "cookies": [
            "locale",
            "gdpr_consent",
            "timezone",
            "state_selection"
          ]
        }
      },
      "compressionSupport": true,
      "germanSpecific": {
        "holidayDataOptimization": true,
        "stateBasedCaching": true,
        "timezoneAwareCaching": true
      }
    },
    "HOLIDAY_DATA_CACHE_POLICY": {
      "name": "TimeButler-Holiday-Data-Cache",
      "comment": "Optimized caching for German holiday data API endpoints",
      "defaultTTL": 86400,
      "maxTTL": 604800,
      "minTTL": 3600,
      "parametersInCacheKeyAndForwardedToOrigin": {
        "enableAcceptEncodingBrotli": true,
        "enableAcceptEncodingGzip": true,
        "queryStringsConfig": {
          "queryStringBehavior": "whitelist",
          "queryStrings": [
            "state",
            "year",
            "format",
            "lang"
          ]
        },
        "headersConfig": {
          "headerBehavior": "whitelist",
          "headers": [
            "Accept-Language",
            "CloudFront-Viewer-Country-Region"
          ]
        },
        "cookiesConfig": {
          "cookieBehavior": "none"
        }
      },
      "compressionSupport": true,
      "varyOnHeaders": ["Accept-Language"],
      "germanStates": {
        "cachingStrategy": "per_state",
        "states": [
          "BW", "BY", "BE", "BB", "HB", "HH", "HE", "MV",
          "NI", "NW", "RP", "SL", "SN", "ST", "SH", "TH"
        ]
      }
    },
