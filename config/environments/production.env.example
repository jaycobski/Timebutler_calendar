# Production Environment Configuration for German Market
# Timebutler Calendar MVP - German Holiday Bridge Weekend Optimizer

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=production
PORT=3000

# Application URLs (HTTPS required for production)
APP_URL=https://calendar.timebutler.de
API_URL=https://api-calendar.timebutler.de

# =============================================================================
# DATABASE CONFIGURATION (EU-CENTRAL-1 REGION - FRANKFURT)
# =============================================================================
# PostgreSQL for analytics (AWS RDS eu-central-1)
DATABASE_URL=postgresql://username:password@timebutler-calendar-prod.cluster-xyz.eu-central-1.rds.amazonaws.com:5432/timebutler_calendar

# Redis for caching (AWS ElastiCache eu-central-1)
REDIS_URL=rediss://timebutler-calendar-prod.xyz.cache.amazonaws.com:6380

# Connection pooling for production
DATABASE_POOL_MIN=5
DATABASE_POOL_MAX=50
REDIS_POOL_MIN=5
REDIS_POOL_MAX=20

# =============================================================================
# GERMAN MARKET APIS
# =============================================================================
# Official German Holiday API
GERMAN_HOLIDAY_API_KEY=prod_german_holiday_api_key
GERMAN_HOLIDAY_API_URL=https://feiertage-api.de/api
GERMAN_HOLIDAY_FALLBACK_URL=https://get.api-feiertage.de

# Bundesländer state data
BUNDESLANDER_API_URL=https://bund.dev/api/states

# =============================================================================
# EMAIL SERVICE (GDPR COMPLIANT - EU REGION)
# =============================================================================
# Resend API configured for EU region
RESEND_API_KEY=re_prod_resend_api_key
RESEND_REGION=eu
FROM_EMAIL=kalender@timebutler.de
REPLY_TO_EMAIL=support@timebutler.de
BOUNCE_EMAIL=bounce@timebutler.de

# Email rate limiting
EMAIL_RATE_LIMIT=100  # emails per hour
EMAIL_QUEUE_ENABLED=true

# =============================================================================
# TIMEZONE & LOCALIZATION (GERMAN MARKET)
# =============================================================================
DEFAULT_TIMEZONE=Europe/Berlin
SUPPORTED_LOCALES=de-DE,en-US
DEFAULT_LOCALE=de-DE

# German business hours for support
BUSINESS_HOURS_START=09:00
BUSINESS_HOURS_END=18:00
BUSINESS_TIMEZONE=Europe/Berlin

# =============================================================================
# GDPR COMPLIANCE (STRICT GERMAN REQUIREMENTS)
# =============================================================================
# Data retention (German privacy law requirements)
USER_SESSION_RETENTION_DAYS=90
ANALYTICS_RETENTION_DAYS=730
EXPORT_LINK_EXPIRY_DAYS=30
LOG_RETENTION_DAYS=180

# Cookie consent (mandatory for German users)
COOKIE_CONSENT_REQUIRED=true
ANALYTICS_TRACKING_ID=G-XXXXXXXXXX
GDPR_CONTACT_EMAIL=datenschutz@timebutler.de

# Data processing legal basis
DATA_PROCESSING_LEGAL_BASIS=consent
DATA_CONTROLLER=TimeButler GmbH

# =============================================================================
# PERFORMANCE & CACHING (GERMAN TRAFFIC PATTERNS)
# =============================================================================
# Cache TTL optimized for German planning seasons
HOLIDAY_CACHE_TTL=2592000    # 30 days (holidays change rarely)
BRIDGE_WEEKEND_CACHE_TTL=604800  # 7 days (refresh weekly)
EXPORT_CACHE_TTL=1800        # 30 minutes (frequent exports)

# Rate limiting (handle December/January traffic spikes)
RATE_LIMIT_REQUESTS=500      # Conservative for production
RATE_LIMIT_WINDOW=3600       # 1 hour
BURST_RATE_LIMIT=50          # Handle sudden spikes

# Connection limits for German traffic patterns
MAX_CONCURRENT_CONNECTIONS=10000
KEEP_ALIVE_TIMEOUT=30

# =============================================================================
# CDN & STATIC ASSETS (EUROPEAN DISTRIBUTION)
# =============================================================================
# CloudFront with Frankfurt edge locations
CDN_URL=https://d123xyz.cloudfront.net
STATIC_ASSETS_URL=https://assets-calendar.timebutler.de

# European edge locations priority
CDN_EDGE_LOCATIONS=eu-central-1,eu-west-1,eu-west-2

# Asset optimization
ASSET_COMPRESSION=gzip,brotli
IMAGE_OPTIMIZATION=webp,avif
JS_MINIFICATION=true
CSS_MINIFICATION=true

# =============================================================================
# SECURITY (GERMAN SECURITY STANDARDS)
# =============================================================================
# JWT for signed export URLs
JWT_SECRET=secure_production_jwt_secret_256_bits_minimum
JWT_EXPIRY=30d
JWT_ISSUER=timebutler-calendar

# HTTPS enforcement
FORCE_HTTPS=true
HSTS_MAX_AGE=31536000
SECURE_COOKIES=true

# CORS for German domains
ALLOWED_ORIGINS=https://timebutler.de,https://www.timebutler.de,https://calendar.timebutler.de

# Security headers
CSP_ENABLED=true
REFERRER_POLICY=strict-origin-when-cross-origin

# =============================================================================
# MONITORING & ALERTING (GERMAN BUSINESS HOURS)
# =============================================================================
LOG_LEVEL=info
LOG_FORMAT=json
LOG_DESTINATION=cloudwatch

# Health checks
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_INTERVAL=30  # seconds
READINESS_CHECK_TIMEOUT=5

# Metrics and monitoring
METRICS_ENABLED=true
METRICS_NAMESPACE=TimeButler/Calendar
CLOUDWATCH_REGION=eu-central-1

# Alerting (German business hours)
ALERT_EMAIL=ops@timebutler.de
ALERT_PHONE=+49-xxx-xxx-xxxx
ALERT_BUSINESS_HOURS_ONLY=true

# =============================================================================
# SCALING & PERFORMANCE (25,000 CONCURRENT USERS)
# =============================================================================
# Application scaling
MIN_INSTANCES=2
MAX_INSTANCES=20
TARGET_CPU_UTILIZATION=70
AUTO_SCALING_COOLDOWN=300

# Database scaling
DATABASE_READ_REPLICAS=2
DATABASE_CONNECTION_TIMEOUT=10

# Queue processing for email delivery
QUEUE_WORKERS=5
QUEUE_CONCURRENCY=10

# =============================================================================
# BACKUP & DISASTER RECOVERY
# =============================================================================
# Automated backups (German data residency)
DATABASE_BACKUP_RETENTION=30  # days
DATABASE_BACKUP_SCHEDULE=0 2 * * *  # 2 AM CET daily

# Disaster recovery
DR_REGION=eu-west-1  # Frankfurt primary, Ireland backup
RTO_MINUTES=15       # Recovery Time Objective
RPO_MINUTES=5        # Recovery Point Objective