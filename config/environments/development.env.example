# Development Environment Configuration for German Market
# Timebutler Calendar MVP - German Holiday Bridge Weekend Optimizer

# =============================================================================
# APPLICATION SETTINGS
# =============================================================================
NODE_ENV=development
PORT=3000
API_PORT=3001

# Application URL (for email links and CORS)
APP_URL=http://localhost:3000
API_URL=http://localhost:3001

# =============================================================================
# DATABASE CONFIGURATION (European Data Centers)
# =============================================================================
# PostgreSQL for analytics (use eu-central-1 region in production)
DATABASE_URL=postgresql://user:password@localhost:5432/timebutler_calendar_dev

# Redis for caching and session storage (use eu-central-1 region in production)
REDIS_URL=redis://localhost:6379

# =============================================================================
# GERMAN MARKET SPECIFIC APIS
# =============================================================================
# Official German Holiday API from bundesregierung.de
GERMAN_HOLIDAY_API_KEY=your_german_holiday_api_key_here
GERMAN_HOLIDAY_API_URL=https://feiertage-api.de/api

# Bundesländer API for state-specific data
BUNDESLANDER_API_URL=https://bund.dev/api/states

# =============================================================================
# EMAIL SERVICE (GDPR COMPLIANT)
# =============================================================================
# Resend API for email delivery (EU region)
RESEND_API_KEY=re_your_resend_api_key_here
RESEND_REGION=eu
FROM_EMAIL=noreply@timebutler.de
REPLY_TO_EMAIL=support@timebutler.de

# =============================================================================
# TIMEZONE & LOCALIZATION
# =============================================================================
# German timezone handling (CET/CEST)
DEFAULT_TIMEZONE=Europe/Berlin
SUPPORTED_LOCALES=de-DE,en-US
DEFAULT_LOCALE=de-DE

# =============================================================================
# GDPR COMPLIANCE
# =============================================================================
# Data retention periods (in days)
USER_SESSION_RETENTION_DAYS=90
ANALYTICS_RETENTION_DAYS=730
EXPORT_LINK_EXPIRY_DAYS=30

# Cookie consent settings
COOKIE_CONSENT_REQUIRED=true
ANALYTICS_TRACKING_ID=

# =============================================================================
# PERFORMANCE & CACHING
# =============================================================================
# Cache TTL in seconds
HOLIDAY_CACHE_TTL=2592000  # 30 days
BRIDGE_WEEKEND_CACHE_TTL=604800  # 7 days
EXPORT_CACHE_TTL=1800  # 30 minutes

# Rate limiting (requests per hour)
RATE_LIMIT_REQUESTS=1000
RATE_LIMIT_WINDOW=3600

# =============================================================================
# CDN & STATIC ASSETS (European Distribution)
# =============================================================================
# Use eu-central-1 for development, CloudFront for production
CDN_URL=http://localhost:3000/static
STATIC_ASSETS_URL=http://localhost:3000/assets

# =============================================================================
# SECURITY
# =============================================================================
# JWT settings for signed export URLs
JWT_SECRET=your_jwt_secret_for_signed_urls_here
JWT_EXPIRY=30d

# CORS settings for German domains
ALLOWED_ORIGINS=http://localhost:3000,https://timebutler.de,https://www.timebutler.de

# =============================================================================
# MONITORING & LOGGING
# =============================================================================
LOG_LEVEL=debug
LOG_FORMAT=json

# Health check endpoints
HEALTH_CHECK_ENABLED=true
METRICS_ENABLED=true

# =============================================================================
# DEVELOPMENT TOOLS
# =============================================================================
BUNDLE_ANALYZE=false
HOT_RELOAD=true
SOURCE_MAPS=true

# Test database (separate from development)
TEST_DATABASE_URL=postgresql://user:password@localhost:5432/timebutler_calendar_test