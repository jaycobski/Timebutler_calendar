    "gdprCompliance": {
      "dataProcessingLegalBasis": "consent",
      "dataController": "TimeButler GmbH",
      "dpoEmail": "datenschutz@timebutler.de",
      "supervisoryAuthority": {
        "name": "BfDI",
        "fullName": "Der Bundesbeauftragte für den Datenschutz und die Informationsfreiheit",
        "website": "https://www.bfdi.bund.de",
        "email": "poststelle@bfdi.bund.de"
      },
      "dataRetention": {
        "userSessions": "90 days",
        "analytics": "25 months",
        "exportLinks": "30 days",
        "emailLogs": "180 days"
      },
      "consentRequirements": {
        "cookieConsent": true,
        "analyticsConsent": true,
        "emailConsent": true,
        "granularConsent": true
      }
    },
    "infrastructure": {
      "cdnConfiguration": {
        "primaryEdgeLocations": ["Frankfurt", "Munich", "Berlin"],
        "secondaryEdgeLocations": ["Amsterdam", "London", "Paris"],
        "geoRestriction": ["DE", "AT", "CH", "EU"],
        "cacheSettings": {
          "staticAssets": "1 year",
          "dynamicContent": "no-cache",
          "apiResponses": "5 minutes"
        }
      },
      "monitoringConfig": {
        "timezone": "Europe/Berlin",
        "alertingHours": "06:00-22:00",
        "weekendAlerting": "critical-only",
        "germanHolidays": "reduced-alerting"
      },
      "performanceTargets": {
        "pageLoadTime": "< 2 seconds",
        "apiResponseTime": "< 100ms",
        "emailDeliveryTime": "< 5 seconds",
        "concurrentUsers": 25000,
        "availability": "99.9%"
      }
    },
    "emailConfiguration": {
      "provider": "Resend",
      "region": "EU",
      "templates": {
        "german": {
          "addressing": "formal",
          "tone": "professional",
          "language": "de-DE"
        },
        "english": {
          "addressing": "casual",
          "tone": "friendly",
          "language": "en-US"
        }
      },
      "deliverySettings": {
        "retryAttempts": 3,
        "retryBackoff": "exponential",
        "bounceHandling": true,
        "unsubscribeCompliance": true
      }
    },
    "apiIntegrations": {
      "holidayData": {
        "primary": "https://feiertage-api.de/api",
        "fallback": "https://get.api-feiertage.de",
        "updateFrequency": "daily",
        "cacheStrategy": "30-day-ttl"
      },
      "stateData": {
        "source": "https://bund.dev/api/states",
        "updateFrequency": "monthly",
        "cacheStrategy": "persistent"
      }
    },
    "scalingConfiguration": {
      "autoScaling": {
        "minInstances": 2,
        "maxInstances": 20,
        "targetCpuUtilization": 70,
        "scaleUpCooldown": 300,
        "scaleDownCooldown": 600
      },
      "loadBalancing": {
        "algorithm": "round-robin",
        "healthCheckInterval": 30,
        "healthCheckTimeout": 5,
        "healthCheckThreshold": 3
      },
      "trafficPatterns": {
        "dailyPeak": "14:00-16:00 CET",
        "weeklyPeak": "Sunday evening",
        "seasonalPeak": "December 1-31",
        "flashTraffic": "25,000 concurrent users"
      }
    },
    "securityConfiguration": {
      "tlsVersion": "1.2+",
      "hstsMaxAge": 31536000,
      "contentSecurityPolicy": "strict",
      "xssProtection": true,
      "frameOptions": "DENY",
      "cookieSettings": {
        "secure": true,
        "httpOnly": true,
        "sameSite": "Strict"
      }
    }
  }
