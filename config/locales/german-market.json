      "workingDays": ["monday", "tuesday", "wednesday", "thursday", "friday"],
      "businessHours": {
        "start": "09:00",
        "end": "18:00",
        "timezone": "Europe/Berlin"
      },
      "peakPlanningSeasons": {
        "december": {
          "trafficMultiplier": 3.0,
          "description": "Christmas holiday planning peak"
        },
        "january": {
          "trafficMultiplier": 2.0,
          "description": "New year vacation planning"
        },
        "easter": {
          "trafficMultiplier": 1.8,
          "description": "Easter bridge weekend planning"
        }
      },
      "germanSchoolHolidays": {
        "summer": {
          "duration": "6 weeks",
          "staggered": true,
          "description": "Different dates per Bundesland"
        },
        "winter": {
          "duration": "2 weeks",
          "uniform": true,
          "description": "Christmas/New Year break"
        }
      }
