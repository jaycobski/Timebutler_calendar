      }
    },
    {
      "id": "vacation-plan-creation",
      "name": "Vacation Plan Creation",
      "request": {
        "method": "POST",
        "urlPath": "/v1/vacation-plan"
      },
      "response": {
        "status": 201,
        "headers": {
          "Content-Type": "application/json",
          "Location": "/v1/vacation-plan/{{randomValue type='UUID'}}"
        },
        "jsonBody": {
          "id": "{{randomValue type='UUID'}}",
          "created_at": "{{now format='yyyy-MM-dd HH:mm:ss'}}",
          "state": "{{request.body.state}}",
          "language": "{{request.body.language}}",
          "email": "{{request.body.email}}",
          "vacation_plan_name": "{{request.body.vacation_plan_name}}",
          "selected_bridges": "{{request.body.selected_bridges}}",
          "gdpr_consent": "{{request.body.gdpr_consent}}",
          "status": "created",
          "calendar_ready": true,
          "pdf_ready": "{{randomValue type='BOOLEAN'}}"
        },
        "fixedDelayMilliseconds": "{{randomInt lower=100 upper=400}}"
      }
    },
    {
      "id": "email-delivery",
      "name": "Email Delivery",
      "request": {
        "method": "POST",
        "urlPathPattern": "/v1/vacation-plan/([a-f0-9-]+)/email"
      },
      "response": {
        "status": "{{randomValue type='WEIGHTED' values='200,200,200,200,202'}}",
        "headers": {
          "Content-Type": "application/json",
          "X-GDPR-Compliant": "true",
          "X-Email-Service": "Resend"
        },
        "jsonBody": {
          "status": "{{randomValue type='WEIGHTED' values='sent,sent,sent,queued'}}",
          "message_id": "{{randomValue type='UUID'}}",
          "email_sent_to": "{{request.body.email || 'test@example.com'}}",
          "delivery_language": "{{request.body.delivery_language}}",
          "queue_time": "{{randomInt lower=50 upper=500}}",
          "processing_time": "{{randomInt lower=200 upper=1500}}",
          "template_render_time": "{{randomInt lower=100 upper=400}}",
          "smtp_connection_time": "{{randomInt lower=20 upper=150}}",
          "estimated_delivery": "{{now offset='5 seconds' format='yyyy-MM-dd HH:mm:ss'}}",
          "attachments": {
            "calendar": true,
            "pdf_summary": "{{randomValue type='BOOLEAN'}}"
          }
        },
        "fixedDelayMilliseconds": "{{randomInt lower=200 upper=2000}}"
      }
    },
    {
      "id": "health-check",
      "name": "Health Check",
      "request": {
        "method": "GET",
        "urlPath": "/__admin/health"
      },
      "response": {
        "status": 200,
        "headers": {
          "Content-Type": "application/json"
        },
        "jsonBody": {
          "status": "healthy",
          "timestamp": "{{now format='yyyy-MM-dd HH:mm:ss'}}",
          "version": "1.0.0",
          "environment": "load_testing"
        }
      }
    }
